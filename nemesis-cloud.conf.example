# Local build/provisioning config.
#
# To configure a base image before building:
#
#   cp nemesis-cloud.conf.example nemesis-cloud.conf
#   edit nemesis-cloud.conf
#   ./build-image.sh
#
# The real nemesis-cloud.conf file is ignored by git.

# Local console user baked into the image.
# For WSL this is the user that will be created and set as default.
NEMESIS_USER="user"
NEMESIS_USER_PASSWORD="Ch4ngeM3!"

# Empty generates a Windows-style DESKTOP-XXXXXXX hostname during provisioning.
# Most cloud platforms can still replace the hostname with cloud-init metadata.
NEMESIS_HOSTNAME=""

# Installs GNOME desktop, theming, and GNOME Remote Desktop support when true.
ENABLE_GRAPHICAL_LOGIN="false"

# image     = VM/cloud image profile.
# wsl       = WSL profile. Skips desktop/RDP/cloud-init/bootloader/VM services.
# container = Docker/OCI profile. Same skips as WSL, plus systemd hostctl calls.
INSTALL_PROFILE="image"

# Optional public key for the baked local user. Cloud-init/provider keys can
# still be injected later at VM creation time.
SSH_AUTHORIZED_KEY=""

# Initial GNOME Remote Desktop credentials.
RDP_USER="rdp"
RDP_PASSWORD="rdp"

# Optional repo source for runtime asset refreshes. Usually leave empty for the
# Packer build because assets are copied into the image.
NEMESIS_REPO_URL=""
NEMESIS_REPO_REF="main"
